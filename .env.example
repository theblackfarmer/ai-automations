# Copy to .env (or export in your shell). NEVER commit your real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
AUTOMATIONS_MODEL=claude-sonnet-4-6

# Optional — if unset, output prints to the console instead of Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — comma-separated RSS feeds for the news/briefing automations
NEWS_FEEDS=https://feeds.marketwatch.com/marketwatch/topstories/
