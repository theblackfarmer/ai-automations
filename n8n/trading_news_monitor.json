{
  "name": "AI Trading News Monitor — NAS100 & Gold",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 2 }] }
      },
      "id": "b2000000-0001-4a02-9002-000000000001",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://feeds.marketwatch.com/marketwatch/topstories/",
        "options": {}
      },
      "id": "b2000000-0002-4a02-9002-000000000002",
      "name": "Read Market News (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { headlines: $input.all().map(i => i.json.title).filter(Boolean).slice(0, 30).join('\\n') } }];"
      },
      "id": "b2000000-0003-4a02-9002-000000000003",
      "name": "Collect Headlines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "YOUR_ANTHROPIC_API_KEY" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 700,\n  \"system\": \"You are a markets analyst. From the headlines, identify ONLY items likely to move NAS100 (US tech / Nasdaq) or GOLD (XAUUSD). For each relevant item give: [NAS100 or GOLD] | likely direction (up/down/volatile) | impact (HIGH/MED/LOW) | one-line why. Ignore everything irrelevant. If nothing is relevant, reply exactly: 'No high-impact NAS100/Gold news right now.' Be concise and honest — this is decision-support, not financial advice.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Headlines:\\n{{ $json.headlines }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "b2000000-0004-4a02-9002-000000000004",
      "name": "Claude — Analyze Impact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=📊 NAS100 / GOLD news scan\n\n{{ $json.content[0].text }}",
        "additionalFields": {}
      },
      "id": "b2000000-0005-4a02-9002-000000000005",
      "name": "Send Alert (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 300]
    }
  ],
  "connections": {
    "Every 2 Hours": { "main": [[{ "node": "Read Market News (RSS)", "type": "main", "index": 0 }]] },
    "Read Market News (RSS)": { "main": [[{ "node": "Collect Headlines", "type": "main", "index": 0 }]] },
    "Collect Headlines": { "main": [[{ "node": "Claude — Analyze Impact", "type": "main", "index": 0 }]] },
    "Claude — Analyze Impact": { "main": [[{ "node": "Send Alert (Telegram)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
