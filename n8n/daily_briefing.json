{
  "name": "AI Daily Market Briefing — NAS100 & Gold",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 30 6 * * 1-5" }] }
      },
      "id": "c3000000-0001-4a03-9003-000000000001",
      "name": "Weekdays 6:30am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": { "url": "https://feeds.marketwatch.com/marketwatch/topstories/", "options": {} },
      "id": "c3000000-0002-4a03-9003-000000000002",
      "name": "Read Market News (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { headlines: $input.all().map(i => i.json.title).filter(Boolean).slice(0, 40).join('\\n') } }];"
      },
      "id": "c3000000-0003-4a03-9003-000000000003",
      "name": "Collect Headlines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "YOUR_ANTHROPIC_API_KEY" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 600,\n  \"system\": \"You are a pre-market analyst writing for a trader of NAS100 and GOLD (XAUUSD). Using the headlines, write a concise pre-market briefing with four short sections: 1) Overnight tone, 2) Key items for NAS100, 3) Key items for GOLD, 4) What to watch today. Under 200 words, bullet style, honest about uncertainty. Decision-support, not financial advice.\",\n  \"messages\": [ { \"role\": \"user\", \"content\": \"Today's headlines:\\n{{ $json.headlines }}\" } ]\n}",
        "options": {}
      },
      "id": "c3000000-0004-4a03-9003-000000000004",
      "name": "Claude — Write Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🗞️ Pre-Market Briefing — NAS100 & Gold\n\n{{ $json.content[0].text }}",
        "additionalFields": {}
      },
      "id": "c3000000-0005-4a03-9003-000000000005",
      "name": "Send Briefing (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 300]
    }
  ],
  "connections": {
    "Weekdays 6:30am": { "main": [[{ "node": "Read Market News (RSS)", "type": "main", "index": 0 }]] },
    "Read Market News (RSS)": { "main": [[{ "node": "Collect Headlines", "type": "main", "index": 0 }]] },
    "Collect Headlines": { "main": [[{ "node": "Claude — Write Briefing", "type": "main", "index": 0 }]] },
    "Claude — Write Briefing": { "main": [[{ "node": "Send Briefing (Telegram)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
